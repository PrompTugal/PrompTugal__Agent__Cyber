+          # pull request, and deleted after the first green run on dev or after 24 hours; empty otherwise
+          BOOTSTRAP_ANCHOR: ${{ vars.SIG_BOOTSTRAP_ANCHOR }}
         run: |
+          if [ -n "${BOOTSTRAP_ANCHOR:-}" ]; then
+            [[ "$BOOTSTRAP_ANCHOR" =~ ^[0-9a-f]{40}$ ]] || { echo "SIG_BOOTSTRAP_ANCHOR is not 40 hex digits: refusing" >&2; exit 1; }
+            anchor="$BOOTSTRAP_ANCHOR"; echo "anchor set by PrompTugal__IaC: $anchor"
+          else
           anchor=$(node -e '
             const h = { authorization: `Bearer ${process.env.GH_TOKEN}`, accept: "application/vnd.github+json", "user-agent": "cyber-promptugal-ci" };
             const api = `https://api.github.com/repos/${process.env.REPO}`, path = process.env.WORKFLOW_PATH;
@@ -76,6 +83,7 @@ jobs:
               }
             })().catch(e => { console.error(String(e.message || e)); process.exit(1); });
           ')
+          fi
           echo "ANCHOR=$anchor" >> "$GITHUB_ENV"
       - id: trusted
         name: Take every security check from the anchor's tree
