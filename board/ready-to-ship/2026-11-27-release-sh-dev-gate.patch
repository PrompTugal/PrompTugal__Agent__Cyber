diff --git a/scripts/release.sh b/scripts/release.sh
index ca426dc..fabb8d0 100755
--- a/scripts/release.sh
+++ b/scripts/release.sh
@@ -10,6 +10,64 @@ git fetch -q origin dev
 # The signature check runs as it stood at the last release (origin/dev), never from the tree being pushed, so a push
 # cannot change its own checker (videos.b@'s finding via conductor.b@, 19 Nov 2026, 14:01 UTC).
 [ "$(git rev-parse --is-shallow-repository)" = "false" ] || { echo "a shallow clone: fetch the whole history first" >&2; exit 1; }
+# --- the dev-gate release step -------------------------------------------------------------------------------------
+# work/cl-6.cyber is fixed (cl-6.security, 27 Nov 2026); GATE_POLL_SECONDS and GATE_POLL_MAX are for tests (1 to 2 minutes, about 20 minutes).
+readonly RELEASE_AGENT=cl-6.cyber; GATE_POLL_SECONDS="${GATE_POLL_SECONDS:-90}"; GATE_POLL_MAX="${GATE_POLL_MAX:-1200}"
+# timing only, but bounded: whole numbers, a poll of 1 to 300 s and a wait of at most 3600 s (cl-6.security, 27 Nov 2026)
+[[ "$GATE_POLL_SECONDS" =~ ^[0-9]+$ && "$GATE_POLL_MAX" =~ ^[0-9]+$ ]] || { echo "GATE_POLL_SECONDS and GATE_POLL_MAX must be whole numbers" >&2; exit 1; }
+[ "$GATE_POLL_SECONDS" -ge 1 ] && [ "$GATE_POLL_SECONDS" -le 300 ] || { echo "GATE_POLL_SECONDS must be 1 to 300" >&2; exit 1; }
+[ "$GATE_POLL_MAX" -le 3600 ] || { echo "GATE_POLL_MAX must be at most 3600" >&2; exit 1; }
+# Returns 0: dev is at our SHA. 2: dev moved to something else (rebase and try again). 1: refused or timed out (stop).
+# dev moved after we pushed: merge origin/dev into our branch with a signed merge commit and push again as a fast-forward
+# (PrompTugal__IaC #35: no rebase and no force once work/<agent> holds our commit; to drop a refused commit, revert it).
+merge_ref() {   # merge_ref <ref> : a signed merge commit with our Agent: and Claude-Session: trailers
+  local agent session
+  agent=$(git log -1 --format='%(trailers:key=Agent,valueonly,separator=)' HEAD | tr -d '\n')
+  session=$(git log -1 --format='%(trailers:key=Claude-Session,valueonly,separator=)' HEAD | tr -d '\n')
+  [ -n "$agent" ] && [ -n "$session" ] || { echo "HEAD has no Agent: or Claude-Session: trailer: refusing to merge" >&2; return 1; }
+  git merge -q --no-ff -S -m "$agent: merge $1 into work/$RELEASE_AGENT
+
+Agent: $agent
+Claude-Session: $session" "$1" || { git merge --abort 2>/dev/null; return 1; }
+}
+# Step 4 of the final recipe: our push was refused as a non-fast-forward, so something else moved. Merge what moved into our
+# branch with signed merge commits (never a rebase or a force once anything is pushed). That is origin/dev and, if
+# work/<agent> holds a commit we lack, that tip too, unless the gate refused it: then stop; a person makes a signed revert.
+merge_for_retry() {
+  local tip
+  git fetch -q origin dev
+  git merge-base --is-ancestor origin/dev HEAD || merge_ref origin/dev || return 1
+  if git fetch -q origin "refs/heads/work/$RELEASE_AGENT:refs/remotes/origin/work/$RELEASE_AGENT" 2>/dev/null; then
+    tip=$(git rev-parse "origin/work/$RELEASE_AGENT")
+    if ! git merge-base --is-ancestor "$tip" HEAD; then
+      if git ls-remote --tags origin "refs/tags/gate/$RELEASE_AGENT/${tip:0:12}-fail" | awk '{print $2}' | grep -qx "refs/tags/gate/$RELEASE_AGENT/${tip:0:12}-fail"; then
+        echo "work/$RELEASE_AGENT ends at ${tip:0:12}, which the gate refused: make a signed revert of it, then release again (never rewrite)" >&2; return 1
+      fi
+      merge_ref "origin/work/$RELEASE_AGENT" || return 1
+    fi
+  fi
+}
+# Returns 0: dev is at our SHA (released). 3: the push was refused as a non-fast-forward (merge and go again). 1: stop.
+release_via_work() {
+  local sha sha12 waited=0 devsha out
+  sha=$(git rev-parse HEAD); sha12=${sha:0:12}
+  # step 2: a plain push to work/<agent>; never a force, never dev or main
+  if ! out=$(git -c push.negotiate=true push -q origin "HEAD:refs/heads/work/$RELEASE_AGENT" 2>&1); then
+    if printf '%s' "$out" | grep -qE 'non-fast-forward|fetch first|\[rejected\]'; then echo "work/$RELEASE_AGENT refused the push as a non-fast-forward: merging what moved" >&2; return 3; fi
+    echo "could not push work/$RELEASE_AGENT: $out" >&2; return 1
+  fi
+  echo "pushed $sha12 to work/$RELEASE_AGENT; waiting for the gate to fast-forward dev"
+  # step 3: poll until dev is our SHA, the gate refuses it (the exact fail ref), or we time out
+  while [ "$waited" -le "$GATE_POLL_MAX" ]; do
+    devsha=$(git ls-remote origin refs/heads/dev | cut -f1)
+    if [ "$devsha" = "$sha" ]; then echo "released $sha12 to dev"; return 0; fi
+    if git ls-remote --tags origin "refs/tags/gate/$RELEASE_AGENT/$sha12-fail" | awk '{print $2}' | grep -qx "refs/tags/gate/$RELEASE_AGENT/$sha12-fail"; then
+      echo "the gate refused $sha12 (tag gate/$RELEASE_AGENT/$sha12-fail): stopping; undo it with a signed revert, never rewrite" >&2; return 1
+    fi
+    sleep "$GATE_POLL_SECONDS"; waited=$((waited + GATE_POLL_SECONDS))
+  done
+  echo "timed out after ${GATE_POLL_MAX}s waiting for dev to reach $sha12: stopping; a person decides" >&2; return 1
+}
 SIGTMP=$(mktemp -d); trap 'rm -rf "$SIGTMP"' EXIT
 # Every security check (signatures, trailers, leak scan) runs as it stood at the last release, never from the pushed tree
 # (security@'s control 7 widened, 19 Nov 2026). A missing trusted copy stops the release: git show fails under set -e.
@@ -25,10 +83,7 @@ node scripts/test-sectors.mjs
 trusted leak-scan.mjs
 trusted check-commits.mjs origin/dev HEAD
 sigcheck origin/dev HEAD
-for i in 1 2 3 4 5; do
-  git fetch -q origin dev
-  git rebase -q origin/dev
-  # One gate per line: under set -e a failure inside an && chain does not stop the script (specialist.code@ finding 1).
+run_gates() {
   node scripts/build.mjs >/dev/null
   node scripts/validate.mjs >/dev/null
   node scripts/test-leak-scan.mjs >/dev/null
@@ -39,7 +94,21 @@ for i in 1 2 3 4 5; do
   trusted leak-scan.mjs >/dev/null
   trusted check-commits.mjs origin/dev HEAD >/dev/null
   sigcheck origin/dev HEAD >/dev/null
-  if git -c push.negotiate=true push -q origin HEAD:dev; then echo "released $(git rev-parse --short HEAD) to dev"; exit 0; fi
-  sleep $((i * 3))
-done
-echo "release failed after 5 attempts" >&2; exit 1
+}
+# Bounded rounds (final recipe): round 1 builds on origin/dev; a later round only follows a non-fast-forward refusal.
+MERGE_NEXT=0
+release_rounds() {
+  local i rc
+  for i in 1 2 3; do
+    git fetch -q origin dev
+    if [ "$MERGE_NEXT" = 1 ]; then merge_for_retry || { echo "stopping: work/$RELEASE_AGENT needs a person (see above)" >&2; return 1; }
+    else git rebase -q origin/dev; fi   # nothing of this run is pushed yet, so a local rebase rewrites nothing shared
+    run_gates
+    rc=0; release_via_work || rc=$?
+    [ "$rc" = 0 ] && return 0
+    [ "$rc" = 3 ] || return 1
+    MERGE_NEXT=1
+  done
+  echo "release failed after 3 rounds" >&2; return 1
+}
+release_rounds || exit 1
